# =========================
# Data — raw/
# All raw data is large, protected or available to download from source.
# See data/README.qmd for sources and download instructions.
# =========================
data/raw/*

# =========================
# Data — processed/
# Processed files are either too large to track or are regenerated
# by the pipeline. .gitkeep files preserve empty directories.
# Un-ignoring a file inside an ignored dir requires un-ignoring the dir first.
# =========================
data/processed/*
!data/processed/household_surveys/
data/processed/household_surveys/*
!data/processed/household_surveys/.gitkeep

!data/processed/training_subcomponents/
data/processed/training_subcomponents/*
!data/processed/training_subcomponents/.gitkeep

!data/processed/prediction/
data/processed/prediction/*
!data/processed/prediction/.gitkeep

!data/processed/survey_boundaries/
data/processed/survey_boundaries/*
!data/processed/survey_boundaries/.gitkeep

!data/processed/sampled_features/
data/processed/sampled_features/*
!data/processed/sampled_features/.gitkeep

# =========================
# Outputs
# All outputs are regenerated by running the pipeline.
# .gitkeep files preserve empty directories.
# =========================
outputs/cluster_analysis/*
!outputs/cluster_analysis/sanitation/
outputs/cluster_analysis/sanitation/*
!outputs/cluster_analysis/sanitation/.gitkeep

!outputs/cluster_analysis/smdw/
outputs/cluster_analysis/smdw/*
!outputs/cluster_analysis/smdw/.gitkeep

outputs/model_performance/*
!outputs/model_performance/predictions/
outputs/model_performance/predictions/*
!outputs/model_performance/predictions/.gitkeep

!outputs/model_performance/figures/
outputs/model_performance/figures/*
!outputs/model_performance/figures/.gitkeep

!outputs/model_performance/plots/
outputs/model_performance/plots/*
!outputs/model_performance/plots/.gitkeep

outputs/descriptive_statistics/*
!outputs/descriptive_statistics/.gitkeep

outputs/main_figures/*
!outputs/main_figures/.gitkeep

outputs/figures/*
!outputs/figures/.gitkeep

outputs/survey_estimates/*
!outputs/survey_estimates/.gitkeep

# =========================
# Data — back-up/
# =========================
data/back-up/
